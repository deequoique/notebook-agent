{
  "manifest_version": 3,
  "name": "Notebook Agent 浏览器伴侣",
  "version": "0.1.0",
  "description": "从当前 YouTube 或 NTULearn/Kaltura 页面保存字幕到 Notebook Agent。",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtu.be/*",
    "https://ntulearn.ntu.edu.sg/*",
    "https://ntulearnvideo.ntu.edu.sg/*",
    "https://notebookai.deequoique.tech/*"
  ],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "保存当前视频" }
}
