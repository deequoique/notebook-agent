{
  "name": "notebook-agent-browser-companion",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-static.mjs production",
    "build:local": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/copy-static.mjs local",
    "audit": "node scripts/audit-package.mjs production",
    "audit:local": "node scripts/audit-package.mjs local",
    "package": "pnpm build && pnpm run audit",
    "package:local": "pnpm build:local && pnpm run audit:local",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
