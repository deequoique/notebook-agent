[Unit]
Description=Notebook Agent combined Web and MCP runtime
After=network-online.target notebook-agent-dependencies.service notebook-agent-migrate.service
Wants=network-online.target
Requires=notebook-agent-dependencies.service

[Service]
Type=simple
User=notebook-agent
Group=notebook-agent
WorkingDirectory=/opt/notebook-agent/current
EnvironmentFile=/etc/notebook-agent/notebook-agent.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=NOTEBOOK_AGENT_ENV=production
Environment=NOTEBOOK_AGENT_LOG_RETRIEVAL_CONTENT=false
Environment=NOTEBOOK_AGENT_LOG_DIR=/var/log/notebook-agent
Environment=WEB_AUTH_ENABLED=true
Environment=WEB_PUBLIC_ORIGIN=https://notebookai.deequoique.tech
Environment=BROWSER_COMPANION_ALLOWED_ORIGINS=chrome-extension://omogodipchfidpikpeebgmlplpkjnpfm
Environment=WEB_SERVE_STATIC=true
Environment=WEB_STATIC_DIR=web/dist
Environment=WEB_COOKIE_SECURE=true
Environment=WEB_FORWARDED_ALLOW_IPS=127.0.0.1
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8800
Environment=MCP_PATH=/mcp
Environment=MCP_URL_TOKEN_MODE=true
ExecStartPre=/usr/bin/test -f /opt/notebook-agent/current/.migration-admitted
ExecStart=/opt/notebook-agent/current/.venv/bin/python -m app.cli mcp-server --transport streamable-http
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
KillSignal=SIGINT

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/log/notebook-agent
LogsDirectory=notebook-agent
LogsDirectoryMode=0750
UMask=0027

[Install]
WantedBy=multi-user.target
