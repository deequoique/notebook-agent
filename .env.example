# Copy this file to .env for local development. Never commit .env.
# Start with docs/getting-started/configuration.md and choose one runtime profile.
# Values marked "secret" are placeholders only and must be replaced.

# =============================================================================
# 1. PostgreSQL — required by every Notebook Agent profile
# =============================================================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional single-URL override. It takes precedence over POSTGRES_* and usually
# contains a password, so treat it as a secret.
# DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/kb
# One-command deployments using a pooled Neon DATABASE_URL must supply a
# direct, operator-only URL for Alembic. Application processes do not consume it.
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:changeme@host/db?sslmode=require

# =============================================================================
# 2. Embedding and Agent providers — required for natural-language questions
# =============================================================================

# Secret. Gateway query embedding and Celery ingestion must receive the same
# provider configuration. Deterministic inventory/identity commands can run
# without it, but ordinary knowledge questions fail closed.
ZHIPU_API_KEY=
EMBEDDING_MODEL=embedding-3
EMBEDDING_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/embeddings
# Keep aligned with the existing PostgreSQL segment vector(1536) column.
EMBEDDING_DIMENSIONS=1536
# Embedding-3 accepts at most 64 input strings per request.
EMBEDDING_BATCH_SIZE=64

AGENT_MODEL=openai:gpt-5-mini
# Secret when the selected provider requires one.
AGENT_API_KEY=
# Optional OpenAI-compatible endpoint, normally ending in /v1.
# AGENT_BASE_URL=

# Optional readable PEM bundle for enterprise/private CAs. Configure the same
# path in every gateway/worker process; certificate and hostname verification
# stay enabled. Standard SSL_CERT_FILE / REQUESTS_CA_BUNDLE remain fallbacks.
# TLS_CA_BUNDLE=/absolute/path/to/cacert.pem

# =============================================================================
# 3. Agent safety budgets and conversation context
# =============================================================================

AGENT_TIMEOUT_SECONDS=45
AGENT_TOOL_TIMEOUT_SECONDS=15
AGENT_REQUEST_LIMIT=8
AGENT_TOOL_CALLS_LIMIT=10
# Primary Turn Agent and optional Composer repair each receive a fresh budget.
AGENT_OUTPUT_TOKEN_LIMIT=2000
# One tool-free, same-evidence repair request; it has no internal output retry.
AGENT_COMPOSER_MAX_TOKENS=1000
CONTEXT_MAX_TURNS=8
CONTEXT_TOKEN_BUDGET=6000
CHANNEL_LINK_TTL_SECONDS=600

# =============================================================================
# 4. Logging and environment mode
# =============================================================================

NOTEBOOK_AGENT_LOG_DIR=.runtime/logs
NOTEBOOK_AGENT_LOG_MAX_BYTES=10485760
NOTEBOOK_AGENT_LOG_BACKUP_COUNT=5
NOTEBOOK_AGENT_ENV=production
NOTEBOOK_AGENT_LOG_RETRIEVAL_CONTENT=false
# Local retrieval-detail diagnostics require BOTH development + true.
# Production must remain production + false.

# =============================================================================
# 5. Full mutation profile — Redis, MinIO, worker, and item management
#    Not required for read-only MCP questions/inventory.
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Optional override; may contain credentials and takes precedence.
# The remote broker must durably persist completion messages before ACK
# (equivalent to the bundled Redis AOF + appendfsync=always contract).
# REDIS_URL=redis://localhost:6379/0

# Total broker publish budget; runtime clamps it below the Agent timeout.
BROKER_PUBLISH_TIMEOUT_SECONDS=5
BROKER_PUBLISH_MAX_RETRIES=1
# Per-user durable ingestion and storage ceilings. Existing/replayed items do
# not consume a new-item allowance.
INGEST_MAX_ACTIVE_PER_USER=10
INGEST_DAILY_NEW_ITEM_LIMIT=50
INGEST_MAX_ITEMS_PER_USER=1000
# Global circuit breakers also bound cost when channel identities can create
# more than one tenant.
INGEST_MAX_ACTIVE_GLOBAL=100
INGEST_DAILY_NEW_ITEM_LIMIT_GLOBAL=300
# Every durable dispatch counts, including retries after worker/broker failure.
INGEST_DAILY_DISPATCH_LIMIT_PER_USER=100
INGEST_DAILY_DISPATCH_LIMIT_GLOBAL=1000
# Per-item content bounds. These are checked before object storage or provider
# calls so one oversized transcript cannot consume unbounded memory, storage,
# chunking, or embedding cost.
INGEST_MAX_RAW_TRANSCRIPT_BYTES=5000000
INGEST_MAX_CUES_PER_ITEM=50000
INGEST_MAX_TEXT_CHARS_PER_ITEM=1000000
INGEST_MAX_SEGMENTS_PER_ITEM=5000
INGEST_MAX_EMBEDDING_CHARS_PER_ITEM=2000000
# Total wall-clock limit for each yt-dlp metadata call and bounded subtitle
# acquisition child process. Socket waits are clamped within this deadline.
YOUTUBE_FETCH_TIMEOUT_SECONDS=30
BILIBILI_FETCH_TIMEOUT_SECONDS=30
# Optional on-demand YouTube-only egress. This temporary MVP accepts only a
# credential-free loopback HTTP URL with an explicit port. It is copied only
# into yt-dlp and bounded-subtitle child processes; other services stay direct.
# YOUTUBE_PROXY_URL=http://127.0.0.1:18080

# MINIO_ROOT_* are secrets. MINIO_API_PORT / CONSOLE_PORT are Compose-only
# host mappings; application code uses MINIO_ENDPOINT_URL.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme12345
MINIO_ENDPOINT_URL=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kb-raw

TRASH_RETENTION_DAYS=30
TRASH_PURGE_INTERVAL_SECONDS=3600
TRASH_PURGE_BATCH_SIZE=20
TRASH_PURGE_CLAIM_TIMEOUT_SECONDS=1800
TRASH_PURGE_MAX_DURATION_SECONDS=30
TRASH_PURGE_OBJECT_TIMEOUT_SECONDS=10

# PostgreSQL source-channel completion notification poller. The existing
# Celery Beat and worker --queues=ingest,maintenance are reused. The whole
# sweep budget stays below the interval so purge work is not starved.
INGEST_NOTIFICATION_INTERVAL_SECONDS=10
INGEST_NOTIFICATION_BATCH_SIZE=20
INGEST_NOTIFICATION_CLAIM_TIMEOUT_SECONDS=300
INGEST_NOTIFICATION_MAX_DURATION_SECONDS=8
INGEST_NOTIFICATION_MAX_ATTEMPTS=5
INGEST_NOTIFICATION_RETRY_BASE_SECONDS=5
INGEST_NOTIFICATION_RETRY_MAX_SECONDS=300

# Legacy Redis completion publisher settings are retained for rollback/schema
# compatibility only; the authoritative notification poller does not use or
# schedule this queue.
INGEST_COMPLETION_INTERVAL_SECONDS=60
INGEST_COMPLETION_BATCH_SIZE=20
INGEST_COMPLETION_CLAIM_TIMEOUT_SECONDS=300
INGEST_COMPLETION_MAX_DURATION_SECONDS=30

# =============================================================================
# 6. MCP transport — independent from LangBot
# =============================================================================

# Streamable HTTP listens here. Public deployments stay behind TLS/reverse
# proxy. Bearer Authorization is preferred. MCP and Web are separate runtime
# profiles; if both servers run on one host, assign them different ports.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# Deployment launcher only. Set true only behind an already-configured TLS
# reverse proxy when MCP_HOST intentionally binds beyond loopback.
# NOTEBOOK_AGENT_ALLOW_NON_LOOPBACK=false

# Enable only for a URL-only client. Accepts HTTPS /mcp/c/<opaque-token>, never
# ?token=. Redact full request URIs in proxy/application/analytics logs.
MCP_URL_TOKEN_MODE=false

# MCP_TOKEN is intentionally absent: pass a raw token only to the stdio process,
# e.g. MCP_TOKEN='<raw-token>' python -m app.cli mcp-server --transport stdio.

# =============================================================================
# 7. Same-origin Web API — email OTP + server-side session
# =============================================================================

# Enable only behind an HTTPS reverse proxy. Development/test uses an
# in-process Fake Sender and never logs or exposes login codes. In production,
# select resend or smtp explicitly; login fails closed if the provider or Redis
# is unavailable. Leave EMAIL_PROVIDER unset for the in-process development fake.
WEB_AUTH_ENABLED=false
# EMAIL_PROVIDER=smtp
WEB_API_PREFIX=/api/v1
# Exact public HTTPS origin, with no trailing slash.
WEB_PUBLIC_ORIGIN=https://app.example.com
# Optional browser companion. The unpacked/pilot build has the stable Chrome
# extension ID below; use an exact origin and never a wildcard. Leaving this
# empty means no extension can pair or submit captions.
# BROWSER_COMPANION_ALLOWED_ORIGINS=chrome-extension://omogodipchfidpikpeebgmlplpkjnpfm
BROWSER_COMPANION_PAIRING_TTL_SECONDS=600
BROWSER_COMPANION_GRANT_TTL_SECONDS=7776000
BROWSER_COMPANION_MAX_REQUEST_BYTES=5500000
# Secret: at least 32 random characters, never a browser-visible value.
WEB_AUTH_SECRET=
WEB_SESSION_TTL_SECONDS=2592000
WEB_AUTH_CODE_TTL_SECONDS=600
WEB_AUTH_MAX_ATTEMPTS=5
WEB_AUTH_RESEND_SECONDS=60
WEB_AUTH_EMAIL_WINDOW_SECONDS=900
WEB_AUTH_EMAIL_MAX_SENDS=3
WEB_AUTH_IP_WINDOW_SECONDS=3600
WEB_AUTH_IP_MAX_SENDS=10
# Required only when EMAIL_PROVIDER=resend.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Notebook Agent <login@example.com>
RESEND_TIMEOUT_SECONDS=10
# Required only when EMAIL_PROVIDER=smtp. The current local-development
# provider is Gmail SMTP; use a dedicated App Password, never a real credential here.
# SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
# Comma-separated proxy peer IPs/hosts that may supply X-Forwarded-For.
WEB_TRUSTED_PROXY_HOSTS=

# =============================================================================
# 8. LangBot loopback bridge — required by launcher full/langbot profiles
# =============================================================================

# Secret, at least 32 random characters. External LangBot integration remains
# optional; when installed, the plugin's private .env must contain this value.
CHANNEL_GATEWAY_SECRET=
CHANNEL_GATEWAY_HOST=127.0.0.1
CHANNEL_GATEWAY_PORT=8765

# LangBot official outbound API used only by the maintenance notification
# poller. Use a dedicated API key and keep non-loopback endpoints on HTTPS.
LANGBOT_OUTBOUND_BASE_URL=http://127.0.0.1:5300
LANGBOT_OUTBOUND_API_KEY=
LANGBOT_OUTBOUND_TIMEOUT_SECONDS=10

# CHANNEL_GATEWAY_URL and KB_BOT_CHANNELS belong only in the installed LangBot
# plugin's private .env; see integrations/langbot_kb_plugin/.env.example.

# =============================================================================
# 9. Web process and static delivery
# =============================================================================

# Required in every Web profile, including local; startup rejects false because
# the session and CSRF cookies use the __Host- contract.
WEB_COOKIE_SECURE=true
# Bind the standalone Web server to loopback behind a same-host TLS proxy. Do
# not expose the channel gateway or reuse MCP_* as Web server settings.
WEB_HOST=127.0.0.1
WEB_PORT=8000
# Keep true when this process serves web/dist. Set false only when an external
# static frontend service and reverse proxy provide the SPA on the same public
# origin while routing /api/v1/* here.
WEB_SERVE_STATIC=true
WEB_STATIC_DIR=web/dist
WEB_PUBLISH_BUDGET_SECONDS=5
# Trust forwarded headers only from explicit local reverse-proxy addresses;
# wildcard trust is rejected.
WEB_FORWARDED_ALLOW_IPS=127.0.0.1
